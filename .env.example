# ─────────────────────────────────────────────────────────────
# Bet Performance Dashboard — environment configuration
# Copy this file to `.env` and fill in the values you need.
# The app runs out of the box in MOCK mode with no credentials.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins for the API
CLIENT_ORIGIN=http://localhost:5173

# ── Google Sheets data source ────────────────────────────────
# DATA_SOURCE controls how bets are loaded:
#   mock    -> built-in sample dataset (default, no credentials needed)
#   apikey  -> read a PUBLIC ("anyone with the link") sheet via API key
#   service -> read any sheet shared with a service account (recommended)
#   oauth   -> per-user OAuth 2.0 login flow
DATA_SOURCE=mock

# Default spreadsheet to read (can be overridden per request from the UI)
SPREADSHEET_ID=
WORKSHEET_NAME=Sheet1

# --- apikey mode ---
GOOGLE_API_KEY=

# --- service account mode ---
# Path to the downloaded service-account JSON key file, OR paste the JSON
# directly into GOOGLE_SERVICE_ACCOUNT_JSON (useful for hosting platforms).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- oauth mode ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Durable grant for hosting: when set, the app reads the sheet using this
# refresh token (no interactive login, survives restarts/redeploys).
GOOGLE_REFRESH_TOKEN=

# ── Sharing / deployment ─────────────────────────────────────────
# Set a password to gate the whole app (REQUIRED for a public deployment).
# Leave blank locally for a frictionless dev experience.
APP_PASSWORD=
# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Shared config store (Supabase) — syncs tracker config across devices ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
